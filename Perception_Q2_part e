import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import zipfile

# Unzip the data

with zipfile.ZipFile("SeDriCa_perception_starter_data.zip", 'r') as zip_ref:
    zip_ref.extractall("perception_data")

evidence = pd.read_csv("perception_data/city/crossing_evidence.csv")

# ---------- Thresholds (state these in your report) ----------
PERSON_THRESHOLD_STOP = 0.6   # above this, treat a person as genuinely present
RED_THRESHOLD_STOP = 0.6      # above this, treat the light as genuinely red
PERSON_THRESHOLD_SLOW = 0.3   # above this but below STOP threshold = unclear, be cautious
RED_THRESHOLD_SLOW = 0.3


def baseline_rule(row):
    person_score = row["person_score"]
    red_score = row["red_score"]
    v2x_light = row["v2x_light"]

    # Priority 1: person likely in the way
    if person_score > PERSON_THRESHOLD_STOP:
        return "STOP", "person likely on crossing"

    # Priority 2: light likely red (either camera OR V2X message agrees)
    if red_score > RED_THRESHOLD_STOP or v2x_light == "red":
        return "STOP", "red light detected"

    # Priority 3: evidence is unclear, approach cautiously
    if person_score > PERSON_THRESHOLD_SLOW or red_score > RED_THRESHOLD_SLOW:
        return "SLOW", "evidence unresolved, approaching cautiously"

    # Otherwise, safe to proceed
    return "GO", "clear path, green light"


# ---------- Run this rule on every frame of all three episodes ----------

results = []
for _, row in evidence.iterrows():
    decision, reason = baseline_rule(row)
    results.append({
        "episode": row["episode"],
        "frame": row["frame"],
        "time_s": row["time_s"],
        "decision": decision,
        "reason": reason
    })

results_df = pd.DataFrame(results)
print(results_df.head(10))


# ---------- Show a timeline of decisions for each episode ----------

decision_to_number = {"GO": 0, "SLOW": 1, "STOP": 2}

fig, axes = plt.subplots(3, 1, figsize=(10, 8))
episodes = ["clear_green", "late_red", "person_crossing"]

for i, ep in enumerate(episodes):
    ep_data = results_df[results_df["episode"] == ep]
    decision_nums = ep_data["decision"].map(decision_to_number)
    axes[i].step(ep_data["frame"], decision_nums, where="post", marker='o')
    axes[i].set_yticks([0, 1, 2])
    axes[i].set_yticklabels(["GO", "SLOW", "STOP"])
    axes[i].set_title(f"Decision timeline: {ep}")
    axes[i].set_xlabel("frame")
    axes[i].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()

STALE_THRESHOLD = 0.3   # seconds; messages older than this are not trusted


def revised_rule(row):
    person_score = row["person_score"]
    red_score = row["red_score"]
    v2x_light = row["v2x_light"]
    msg_age = row["time_s"] - row["v2x_sample_time_s"]
    v2x_is_fresh = msg_age <= STALE_THRESHOLD

    # Priority 1: person likely present
    if person_score > PERSON_THRESHOLD_STOP:
        return "STOP", "person likely on crossing"

    vision_says_red = red_score > RED_THRESHOLD_STOP
    v2x_says_red = v2x_is_fresh and (v2x_light == "red")

    # Priority 2: a FRESH v2x message disagrees strongly with vision -> can't resolve confidently
    if v2x_is_fresh and (v2x_light == "red") != vision_says_red and red_score < RED_THRESHOLD_SLOW:
        return "SLOW", "camera and V2X disagree, approaching cautiously"

    # Priority 3: red light, from vision OR a trustworthy (fresh) V2X message
    if vision_says_red or v2x_says_red:
        reason = "red light detected"
        if not v2x_is_fresh:
            reason += " (V2X message stale, ignored)"
        return "STOP", reason

    # Priority 4: unclear evidence
    if person_score > PERSON_THRESHOLD_SLOW or red_score > RED_THRESHOLD_SLOW:
        return "SLOW", "evidence unresolved, approaching cautiously"

    return "GO", "clear path, green light"


# ---------- Run the revised rule on all three episodes ----------

revised_results = []
for _, row in evidence.iterrows():
    decision, reason = revised_rule(row)
    revised_results.append({
        "episode": row["episode"], "frame": row["frame"],
        "time_s": row["time_s"], "decision": decision, "reason": reason
    })

revised_df = pd.DataFrame(revised_results)


# ---------- Compare baseline vs revised, specifically on late_red ----------

fig, axes = plt.subplots(2, 1, figsize=(10, 6), sharex=True)

for ax, df, label in [(axes[0], results_df, "Baseline"), (axes[1], revised_df, "Revised")]:
    ep_data = df[df["episode"] == "late_red"]
    decision_nums = ep_data["decision"].map(decision_to_number)
    ax.step(ep_data["frame"], decision_nums, where="post", marker='o', color='tab:red')
    ax.set_yticks([0, 1, 2])
    ax.set_yticklabels(["GO", "SLOW", "STOP"])
    ax.set_title(f"{label} decisions: late_red episode")
    ax.grid(True, alpha=0.3)

axes[1].set_xlabel("frame")
plt.tight_layout()
plt.show()

print(revised_df[revised_df["episode"] == "late_red"][["frame", "time_s", "decision", "reason"]].to_string(index=False))

reference = pd.read_csv("perception_data/city/crossing_reference.csv")

def perturb_evidence(df, seed, noise_std=0.1, drop_prob=0.1):
    rng = np.random.default_rng(seed)
    df2 = df.copy()
    noise_r = rng.normal(0, noise_std, size=len(df2))
    noise_p = rng.normal(0, noise_std, size=len(df2))
    df2["red_score"] = (df2["red_score"] + noise_r).clip(0, 1)
    df2["person_score"] = (df2["person_score"] + noise_p).clip(0, 1)
    drop_mask = rng.random(len(df2)) < drop_prob
    df2.loc[drop_mask, "v2x_light"] = "unknown"   # simulate a dropped V2X message
    return df2


def run_trial(seed, rule_func):
    perturbed = perturb_evidence(evidence, seed)
    merged = perturbed.merge(reference, on=["episode", "frame"])
    merged["pred"] = merged.apply(rule_func, axis=1)

    missed_stop = ((merged["stop_required"] == 1) & (merged["pred"] != "STOP")).sum()
    unnecessary_stop = ((merged["stop_required"] == 0) & (merged["pred"] == "STOP")).sum()

    delays = {}
    for ep in ["late_red", "person_crossing"]:
        ep_data = merged[merged["episode"] == ep]
        required = ep_data[ep_data["stop_required"] == 1]
        if len(required) == 0:
            continue
        first_required_time = required["time_s"].min()
        stop_rows = ep_data[(ep_data["stop_required"] == 1) & (ep_data["pred"] == "STOP")]
        if len(stop_rows) == 0:
            delays[ep] = None   # never stopped when required
        else:
            delays[ep] = stop_rows["time_s"].min() - first_required_time

    return missed_stop, unnecessary_stop, delays


N_TRIALS = 20
baseline_rows, revised_rows = [], []

for seed in range(N_TRIALS):
    m, u, d = run_trial(seed, lambda row: baseline_rule(row)[0])
    baseline_rows.append({"seed": seed, "missed": m, "unnecessary": u, **d})

    m, u, d = run_trial(seed, lambda row: revised_rule(row)[0])
    revised_rows.append({"seed": seed, "missed": m, "unnecessary": u, **d})

baseline_table = pd.DataFrame(baseline_rows)
revised_table = pd.DataFrame(revised_rows)

print("--- Baseline, 20 trials ---")
print(baseline_table)
print("\nAverage missed-STOP:", baseline_table["missed"].mean())
print("Average unnecessary-STOP:", baseline_table["unnecessary"].mean())

print("\n--- Revised, 20 trials ---")
print(revised_table)
print("\nAverage missed-STOP:", revised_table["missed"].mean())
print("Average unnecessary-STOP:", revised_table["unnecessary"].mean())
